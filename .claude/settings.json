{
  "permissions": {
    "deny": [
      "Edit(../skypermit/**)",
      "Write(../skypermit/**)",
      "WebFetch",
      "WebSearch",
      "mcp__claude_ai_Firecrawl",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "mcp__plugin_desktop-commander_desktop-commander"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)"
    ],
    "additionalDirectories": ["../skypermit"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push:*",
      "git pull:*",
      "git fetch:*"
    ],
    "network": {
      "allowedDomains": [],
      "deniedDomains": ["*"]
    }
  },
  "enabledPlugins": {
    "desktop-commander@knowledge-work-plugins": false
  },
  "disableClaudeAiConnectors": true,
  "enableArtifact": false
}
