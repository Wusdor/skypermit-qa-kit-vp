{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__atlassian__atlassianUserInfo",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getConfluenceContent",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__listJiraIssueComments",
      "mcp__atlassian__search",
      "mcp__atlassian__searchConfluence",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__discover",
      "mcp__atlassian__executeRead",
      "mcp__postman__getAuthenticatedUser",
      "mcp__postman__getWorkspaces",
      "mcp__postman__getWorkspace",
      "mcp__postman__getCollections",
      "mcp__postman__getCollection",
      "mcp__postman__getDuplicateCollectionTaskStatus",
      "mcp__postman__getGeneratedCollectionSpecs",
      "mcp__postman__getEnvironments",
      "mcp__postman__getEnvironment",
      "mcp__postman__getAllSpecs",
      "mcp__postman__getSpec",
      "mcp__postman__getSpecDefinition",
      "mcp__postman__getSpecFiles",
      "mcp__postman__getSpecFile",
      "mcp__postman__getSpecCollections",
      "mcp__postman__getMocks",
      "mcp__postman__getMock",
      "mcp__postman__searchPostmanElements",
      "mcp__postman__getTaggedEntities",
      "mcp__postman__getEnabledTools"
    ],
    "deny": [
      "Edit(../skypermit/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "WebFetch",
      "WebSearch",
      "mcp__claude_ai_Firecrawl",
      "mcp__plugin_atlassian_atlassian",
      "mcp__atlassian__executeDestructive",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "mcp__plugin_desktop-commander_desktop-commander",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)"
    ],
    "ask": [
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(postman collection run:*)",
      "mcp__atlassian__addOrEditJiraIssueComment",
      "mcp__atlassian__createConfluenceContent",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__updateConfluenceContent",
      "mcp__atlassian__executeWrite",
      "mcp__postman__createWorkspace",
      "mcp__postman__updateWorkspace",
      "mcp__postman__createCollection",
      "mcp__postman__putCollection",
      "mcp__postman__duplicateCollection",
      "mcp__postman__generateCollection",
      "mcp__postman__createCollectionRequest",
      "mcp__postman__updateCollectionRequest",
      "mcp__postman__createCollectionResponse",
      "mcp__postman__createEnvironment",
      "mcp__postman__putEnvironment",
      "mcp__postman__createSpec",
      "mcp__postman__createSpecFile",
      "mcp__postman__updateSpecFile",
      "mcp__postman__updateSpecProperties",
      "mcp__postman__generateSpecFromCollection",
      "mcp__postman__syncCollectionWithSpec",
      "mcp__postman__syncSpecWithCollection",
      "mcp__postman__createMock",
      "mcp__postman__updateMock",
      "mcp__postman__publishMock"
    ],
    "additionalDirectories": ["../skypermit"]
  },
  "sandbox": {
    "network": {
      "allowedDomains": ["gateway.postman.com", "skypermit.vercel.app", "dl-cli.pstmn.io", "events.getpostman.com"],
      "deniedDomains": ["api.anthropic.com", "http-intake.logs.us5.datadoghq.com"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__testomatio__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/testomat-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage-report.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
